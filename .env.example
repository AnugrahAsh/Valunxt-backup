# VALUNXT Capital — environment.
# Copy to .env.local and fill in what applies. Every value has a working
# default, so a fresh clone runs with none of this set.

# ---- Public site ----------------------------------------------------------
# The origin used for canonical URLs, Open Graph tags and sitemap entries when
# the request host is not authoritative (a build, a preview deployment). The
# main domain is valunxt.com, which is also the default when this is unset.
# NEXT_PUBLIC_SITE_ORIGIN=https://valunxt.com

# ---- Database -------------------------------------------------------------
# Stores form enquiries and everything the admin panel manages. Leave unset and
# the credentials the PHP build shipped with are used: localhost/XAMPP when the
# site is served from localhost, the Hostinger database otherwise.
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=valunxt_capital_admin
# DB_USER=root
# DB_PASS=

# ---- Admin panel ----------------------------------------------------------
# Signs the admin session cookie. SET THIS before the panel is reachable from
# the internet — without it the secret is derived from DB_PASS.
# ADMIN_SESSION_SECRET=

# The administrator seeded into an empty `users` table on first connection.
# Change the password before going live.
# ADMIN_DEFAULT_NAME=VALUNXT Admin
# ADMIN_DEFAULT_EMAIL=admin@valunxtcapital.com
# ADMIN_DEFAULT_PASS=Admin@123
